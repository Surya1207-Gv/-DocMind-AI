# =============================================================================
# DocMind AI - environment template
# =============================================================================
# Local setup:
#   cp .env.example backend/.env      (Windows: copy .env.example backend\.env)
# then fill in the values below. backend/.env is gitignored and must never be
# committed.
#
# Cloud setup (Render): do NOT upload this file. Set the same keys as
# environment variables in the service dashboard.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - LLM + embeddings provider
# Both the chat model and the embedding model are served through OpenRouter.
# Get a key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# REQUIRED - signs the JWT session tokens
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - Google Gemini fallback LLM
# When set, Gemini is preferred over OpenRouter for generation.
# Get a key at https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - CORS allowlist (comma separated)
# Leave empty in production: FastAPI serves the React build from the same
# origin, so no cross-origin requests are made. Only needed if you host the
# frontend separately.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL - storage
# DATA_DIR is the single writable root for uploads, FAISS indices, the SQLite
# database and logs. Point it at a mounted volume to persist across restarts.
# Defaults to backend/ when unset.
# -----------------------------------------------------------------------------
# DATA_DIR=/data
# FRONTEND_DIST_DIR=/app/frontend/dist

# -----------------------------------------------------------------------------
# OPTIONAL - models
# -----------------------------------------------------------------------------
# LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# EMBEDDING_MODEL=openai/text-embedding-3-small

# -----------------------------------------------------------------------------
# OPTIONAL - RAG tuning (changeable without touching code)
# -----------------------------------------------------------------------------
# CHUNK_SIZE=1000            # characters per chunk
# CHUNK_OVERLAP=150          # characters shared between neighbouring chunks
# TOP_K=8                    # chunks passed to the LLM as context
# RELEVANCE_THRESHOLD=0.5    # below this hybrid score a chunk is discarded
# VECTOR_WEIGHT=0.6          # hybrid score = 0.6*vector + 0.4*BM25
# LEXICAL_COVERAGE_THRESHOLD=0.5
#   Second, independent admission route for retrieval. A passage containing at
#   least this fraction of the query's information content (IDF-weighted term
#   coverage) is admitted on lexical evidence alone.
#   Why it exists: BM25's weight in the fused score is 1-VECTOR_WEIGHT = 0.4,
#   which is BELOW RELEVANCE_THRESHOLD. Without this, a passage that is the
#   single exact match for a query still needed vector_sim >= 0.167 to survive,
#   so lexical evidence could never admit a chunk on its own -- which broke
#   exactly the identifier-style queries BM25 exists to serve ("RFC 8446").
#   Raising this above 1.0 disables the route and restores the old behaviour.
# MAX_UPLOAD_MB=25

# -----------------------------------------------------------------------------
# OPTIONAL - demo seeding
# Indexes the bundled sample PDF on startup so a fresh (or restarted) instance
# is never empty. Recommended on free hosting, where the disk is ephemeral.
# -----------------------------------------------------------------------------
# DEMO_SEED=true
# DEMO_USERNAME=demo
# DEMO_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL - operations
# ADMIN_PASSWORD: only needed to log in as the legacy 'admin' account. When
# unset, that account is created with a random password and cannot be used.
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD=
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OPTIONAL - reranking (second retrieval stage)
# Hybrid fusion decides which ~15 passages are worth considering; reranking then
# decides which of those actually answer the question. "lexical" is the default
# because it costs microseconds and no API calls, which is what makes it viable
# on a free-tier host where a cross-encoder is not.
#   none    - use the fused order as-is
#   lexical - deterministic scorer (coverage, phrase contiguity, substantiveness)
#   llm     - one batched LLM call scoring the candidate pool; sharper, slower
# -----------------------------------------------------------------------------
# RERANKER=lexical
# RERANK_WEIGHT=0.4          # how far reranking may displace the fused score (0-1)
# RERANK_CANDIDATES=15       # size of the shortlist that gets reranked

# -----------------------------------------------------------------------------
# OPTIONAL - query rewriting
# Resolves follow-up questions ("What are its limitations?") against the
# conversation before retrieval. The user's original wording is always what the
# answer is generated for; rewriting only affects what is searched.
# -----------------------------------------------------------------------------
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_USE_LLM=true # false = use the free heuristic rewrite only
# REWRITE_HISTORY_TURNS=4
# MULTI_QUERY_ENABLED=false  # retrieve for several phrasings and merge; costs
#                            # one embedding call per extra phrasing
# MULTI_QUERY_COUNT=3

# -----------------------------------------------------------------------------
# OPTIONAL - answer verification and evidence gating
# Retrieval similarity says a passage is about the right topic. It says nothing
# about whether the answer's claims appear in it. These control the check that
# does, and what happens when it fails.
#   high   (>=75) answer shown as-is
#   medium (>=55) answer shown with a caveat
#   low    (>=35) replaced with "Insufficient information ..."
#   very low      replaced with "Insufficient information ..."
# -----------------------------------------------------------------------------
# An answer is WITHHELD only for reasons that can actually be measured:
#   * retrieval too weak       (EVIDENCE_MIN_TOP_SCORE)
#   * invented numbers/names   (absent from every retrieved passage)
#   * no grounding at all      (except in ELI5, where rewording is the point)
# Low prose overlap on its own lowers confidence but never refuses: lexical
# scoring cannot tell a paraphrase from a fabrication and must not pretend to.
# VERIFICATION_ENABLED=true    # false restores retrieval-score-only confidence
# EVIDENCE_GATE_ENABLED=true   # false shows low-confidence answers with a caveat
# CLAIM_SUPPORT_THRESHOLD=0.55 # lexical grounding a claim needs to count as supported
# EVIDENCE_MIN_TOP_SCORE=0.55  # best passage must reach this before answering at all
# PARAPHRASE_CREDIT=0.5        # credit for a claim that invents nothing but reworded
# PARAPHRASE_MIN_OVERLAP=0.15  # below this a claim is treated as unrelated, not reworded
# CONFIDENCE_HIGH=75
# CONFIDENCE_MEDIUM=55
# CONFIDENCE_LOW=35

# -----------------------------------------------------------------------------
# OPTIONAL - cross-document relationship detection (GET /api/documents/relationships)
# -----------------------------------------------------------------------------
# REL_DUPLICATE_SIMILARITY=0.97
# REL_DUPLICATE_OVERLAP=0.80
# REL_VERSION_SIMILARITY=0.90
# REL_VERSION_OVERLAP=0.35
# REL_SIMILAR_SIMILARITY=0.85
# REL_RELATED_SIMILARITY=0.65
