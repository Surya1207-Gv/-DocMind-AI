# =============================================================================
# DocMind AI - environment template
# =============================================================================
# Local setup:
#   cp .env.example backend/.env      (Windows: copy .env.example backend\.env)
# then fill in the values below. backend/.env is gitignored and must never be
# committed.
#
# Cloud setup (Render): do NOT upload this file. Set the same keys as
# environment variables in the service dashboard.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - LLM + embeddings provider
# Both the chat model and the embedding model are served through OpenRouter.
# Get a key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# REQUIRED - signs the JWT session tokens
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - Google Gemini fallback LLM
# When set, Gemini is preferred over OpenRouter for generation.
# Get a key at https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - CORS allowlist (comma separated)
# Leave empty in production: FastAPI serves the React build from the same
# origin, so no cross-origin requests are made. Only needed if you host the
# frontend separately.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL - storage
# DATA_DIR is the single writable root for uploads, FAISS indices, the SQLite
# database and logs. Point it at a mounted volume to persist across restarts.
# Defaults to backend/ when unset.
# -----------------------------------------------------------------------------
# DATA_DIR=/data
# FRONTEND_DIST_DIR=/app/frontend/dist

# -----------------------------------------------------------------------------
# OPTIONAL - models
# -----------------------------------------------------------------------------
# LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# EMBEDDING_MODEL=openai/text-embedding-3-small

# -----------------------------------------------------------------------------
# OPTIONAL - RAG tuning (changeable without touching code)
# -----------------------------------------------------------------------------
# CHUNK_SIZE=1000            # characters per chunk
# CHUNK_OVERLAP=150          # characters shared between neighbouring chunks
# TOP_K=8                    # chunks passed to the LLM as context
# RELEVANCE_THRESHOLD=0.5    # below this hybrid score a chunk is discarded
# VECTOR_WEIGHT=0.6          # hybrid score = 0.6*vector + 0.4*BM25
# MAX_UPLOAD_MB=25

# -----------------------------------------------------------------------------
# OPTIONAL - demo seeding
# Indexes the bundled sample PDF on startup so a fresh (or restarted) instance
# is never empty. Recommended on free hosting, where the disk is ephemeral.
# -----------------------------------------------------------------------------
# DEMO_SEED=true
# DEMO_USERNAME=demo
# DEMO_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL - operations
# ADMIN_PASSWORD: only needed to log in as the legacy 'admin' account. When
# unset, that account is created with a random password and cannot be used.
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD=
# LOG_LEVEL=INFO
