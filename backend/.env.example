# DocMind AI — Environment Variables Template
# =============================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env  (Windows: copy .env.example .env)
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to git (it's in .gitignore)

# -----------------------------------------------
# Required: OpenRouter API Key
# Get yours at: https://openrouter.ai/keys
# -----------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------
# Optional: Google Gemini API Key (fallback LLM)
# Get yours at: https://aistudio.google.com/app/apikey
# Leave empty to use OpenRouter only
# -----------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------
# Required: JWT Secret Key (for signing auth tokens)
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a long random string — 64+ characters recommended
# -----------------------------------------------
JWT_SECRET_KEY=your_random_256_bit_secret_key_here

# -----------------------------------------------
# Optional: CORS Allowed Origins (comma-separated allowlist)
# -----------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000


