# Keep the build context small and secret-free.

# Secrets
.env
.env.*
!.env.example
backend/.env

# VCS & CI
.git
.github

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
coverage.xml
htmlcov
backend/venv
venv
# Glob, not a literal: a bare `.venv` misses `.venv-test`, `.venv311` and
# friends, each of which is hundreds of MB of build context for nothing.
.venv*

# Node / build output (the image builds the SPA itself in stage 1)
node_modules
frontend/node_modules
frontend/dist
dist

# Runtime state - never bake user data or indices into an image
backend/uploads
backend/faiss_indices
backend/docmind.db*
backend/metadata*.json
data
*.log

# Docs & dev-only material
*.md
!README.md
docs
eval
postman
scripts/dev
